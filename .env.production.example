# Copy to .env next to docker-compose.yml.

# Public hostname; its DNS must point at this server (ports 80 and 443 open).
DOMAIN="quiz.example.com"

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Optional: enables "Generate quiz from PDF".
ANTHROPIC_API_KEY=""

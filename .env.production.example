# Copy to .env next to docker-compose.yml.

# Public hostname; its DNS must point at this server (ports 80 and 443 open).
DOMAIN="quiz.example.com"

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Postgres (the `db` service). docker-compose.yml builds DATABASE_URL from these, so
# there is no DATABASE_URL here. Use a URL-safe password: generate it like AUTH_SECRET.
POSTGRES_PASSWORD=""
POSTGRES_USER="ejs"
POSTGRES_DB="ejs"

# Optional: enables "Generate quiz from PDF".
ANTHROPIC_API_KEY=""

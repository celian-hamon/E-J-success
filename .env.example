# SQLite for local dev. For production, switch the provider in prisma/schema.prisma
# to "postgresql" and point this at your Postgres database.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: enables "Generate quiz from PDF". Without it, uploading a PDF creates an
# empty draft quiz that teachers fill in by hand.
ANTHROPIC_API_KEY=""
